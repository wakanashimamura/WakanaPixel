}

/* ── TITLE LABEL ──────────────────────────────────────── */
#labelTitle {
    font-size: 11pt;
    font-weight: bold;
    color: #7c6af7;
    padding: 10px 16px;
    letter-spacing: 3px;
}

/* ── PIXELATE BUTTON ──────────────────────────────────── */
#btnPixelate {
    background: #3a2a8a;
    border: 2px solid #6a4af7;
    border-radius: 0px;
    color: #ffffff;
    font-size: 10pt;
    font-weight: bold;
    letter-spacing: 2px;
    padding: 12px;
    margin: 10px 14px;
}
#btnPixelate:hover {
    background: #4a3a9a;
    border-color: #9c8aff;
}
#btnPixelate:pressed {
    background: #2a1a7a;
    border-color: #5a3ae7;
    padding-top: 13px;
    padding-bottom: 11px;
}

/* ── SCROLL AREA ──────────────────────────────────────── */
QScrollArea {
    border: none;
    background: transparent;
}

